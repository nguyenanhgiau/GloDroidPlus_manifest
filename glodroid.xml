<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="glodroid" fetch="https://github.com/glodroid/" />
  <remote  name="libcamera"  fetch="https://git.libcamera.org/libcamera" />
  <remote  name="mygitlab"       fetch="git@gitlab.com:glodroid_platform" />
  <remote  name="github"   fetch="https://github.com/" />
  <remote  name="ti"         fetch="https://git.ti.com/git" />

  <project path="device/brcm/rpi4" remote="mygitlab" name="device/glodroid" groups="glodroid" revision="glodroid-a17" />

  <!-- glodroid configuration -->
  <project path="glodroid"                        remote="glodroid" name="glodroid_configuration.git" revision="refs/tags/basedir-v0.9.0" />
  <project path="glodroid/configuration" remote="mygitlab" name="glodroid/glodroid-configuration" groups="glodroid" revision="glodroid-a17" />

  <!-- <project path="glodroid/apks"                   name="glodroid_external_apks.git" revision="refs/tags/apps-v0.8.2" /> -->

  <!-- gpu+display components (vendor) -->
  <project path="glodroid/vendor/minigbm"         remote="mygitlab" name="glodroid/vendor/minigbm"        groups="glodroid" revision="glodroid-a17" />
  <project path="glodroid/vendor/mesa3d"          remote="mygitlab" name="external/mesa3d"         groups="glodroid" revision="glodroid-a17" />


  <!-- camera components (vendor) -->
  <remove-project name="platform/external/libcamera" />
  <project path="external/libcamera" name="external/libcamera" remote="mygitlab" groups="glodroid" revision="glodroid-a17" />
  <project path="external/libpisp" name="raspberry-vanilla/android_external_libpisp" remote="github" revision="android-16.0" />
  <project path="external/libyuv_chromium" name="raspberry-vanilla/android_external_libyuv_chromium" remote="github" revision="android-16.0" />

  <!-- video codecs components (vendor) -->
  <project path="glodroid/vendor/ffmpeg"          remote="mygitlab"      name="glodroid/vendor/ffmpeg"  groups="glodroid" revision="glodroid-a17" clone-depth="1"/>
  <project path="glodroid/vendor/ffmpeg_codec2"   remote="mygitlab"    name="glodroid/vendor/ffmpeg_codec2" groups="glodroid" revision="glodroid-a17" clone-depth="1"/>

  <!-- other components (vendor) -->
  <project path="glodroid/vendor/aospext"         remote="mygitlab" name="glodroid/vendor/aospext"        groups="glodroid" revision="glodroid-a17" />
  <project path="glodroid/vendor/iio-sensors-hal" remote="glodroid" name="glodroid_forks.git" revision="refs/tags/iio-sensors-hal-v0.9.0" />
  <project path="glodroid/vendor/audio"           remote="mygitlab"   name="glodroid/vendor/audio" groups="glodroid" revision="glodroid-a17" />
  <project path="glodroid/vendor/libudev-zero"    remote="glodroid" name="glodroid_forks.git" revision="refs/tags/libudev_zero-v0.8.2" />

  <!-- bootloader components (platform) -->
  <project path="glodroid/bootloader/u-boot"      remote="mygitlab" name="glodroid/bootloader/u-boot"    groups="glodroid" revision="glodroid-a17"/>
  <project path="glodroid/bootloader/atf"         name="platform/external/arm-trusted-firmware" revision="a127b99d5a063c798d1c6d2e1d4791a630f78355" />
  <project path="glodroid/bootloader/raspberry-fw"  remote="github"  name="raspberrypi/firmware.git" revision="57b8dbdce68c8f5e2a425d86e4e7e149e911b9d3" clone-depth="1" />

  <!-- kernel/firmware components (platform) -->
  <project path="glodroid/kernel/broadcom"        remote="mygitlab" name="kernel/glodroid-broadcom" groups="glodroid" revision="glodroid-a17" />

  <!-- compilers for platform components -->
  <project path="prebuilts/gcc/linux-x86/aarch64/gcc-linaro-aarch64-linux-gnu"
                                           remote="glodroid" name="linaro_gcc_prebuilts.git" revision="refs/tags/gcc-linaro-7.4.1-2019.02-x86_64_aarch64-linux-gnu" />
  <project path="prebuilts/gcc/linux-x86/arm/gcc-linaro-arm-eabi"
                                           remote="glodroid" name="linaro_gcc_prebuilts.git" revision="refs/tags/gcc-linaro-7.5.0-2019.12-x86_64_arm-eabi" />

  <!-- glodroid patches-aosp modification -->
  <remove-project name="platform/external/libcxx" />
  <project path="external/libcxx"          remote="mygitlab" name="external/libcxx"         groups="pdk,glodroid" revision="glodroid-a17" />
  <remove-project name="platform/external/tinycompress" />
  <project path="external/tinycompress" name="external/tinycompress" remote="mygitlab" groups="pdk,glodroid" revision="glodroid-a17"/>
  <remove-project name="platform/external/v4l2_codec2" />
  <project path="external/v4l2_codec2" name="external/v4l2_codec2" remote="mygitlab" groups="pdk,glodroid" revision="glodroid-a17"/>
  <!-- <remove-project name="platform/hardware/interfaces" />
  <project path="hardware/interfaces" name="hardware/interfaces" remote="mygitlab" groups="pdk,glodroid" revision="glodroid-a17"/> -->
</manifest>
